@page "/rogatio/{Id:guid}"
@rendermode InteractiveServer

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Shared.Dtos.Suffragium
@using CorpusLegis.Shared.Enums

@inject Clients.CorpusLegisApiClient ApiClient
@inject NavigationManager NavigationManager


<h3>Detalles del Rogatio [ID: xxx ]</h3>

@if (rogatio != null)
{
    <div class="card mt-4">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@rogatio.Title</h4>
        </div>

        <div class="card-body">
            <p class="lead">@rogatio.Content</p>
            <hr />
            <div class="row text-muted">
                <div class="col-sm-2"><strong>Estado: </strong> <span class="badge bg-secondary">@rogatio.Status</span></div>
                <div class="col-sm-6"><strong>ID: </strong> @rogatio.Id</div>
                <div class="col-sm-4"><small><strong>Fecha de creación: </strong> @rogatio.CreatedAt.ToString("g")</small></div>
            </div>
        </div>

        <div class="card-footer">
            @* <div class="col-sm-4"><small><strong>Fecha de creación: </strong> @rogatio.CreatedAt.ToString("g")</small></div> *@
            @if (rogatio.Status == Shared.Enums.RogatioStatus.Inchoatus)
            {
                <i>Aún no se puede votar</i>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.Proposita)
            {
                <i>Abiertos los comentarios para el debate.</i>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.InSuffragium)
            {
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => Vote(SuffragiumValue.Pro)" disabled="@voting">Pro</button>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => Vote(SuffragiumValue.Contra)" disabled="@voting">Contra</button>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => Vote(SuffragiumValue.Abstentio)" disabled="@voting">Absentio</button>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.Approbata)
            {
                <p>Aprobada</p>
                <p>Resultado de la votación: XXXXXX</p>
                <a class="btn btn-sm btn-outline-secondary" href="rogatio/clonar">Clonar Rogatio (pendiente de crear)</a>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.Reprobata)
            {
                <p>Rechazada</p>
                <p>Resultado de la votación: XXXXXX</p>
                <a class="btn btn-sm btn-outline-secondary" href="rogatio/clonar">Clonar Rogatio (pendiente de crear)</a>
            }
        </div>

        <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Inchoatus)">A borrador</button>
        <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Proposita)">Presentar</button>
        <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.InSuffragium)">A votar</button>
        <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Approbata)">Aprobar</button>
        <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Reprobata)">Rechazar</button>

    </div>
}

<a href="/rogatio" class="btn btn-lg btn-dark">Volver al listado de Rogationes</a>



@code {
    [Parameter] public Guid Id { get; set; }

    private RogatioDetailsDto? rogatio;
    private string? errorMessage;
    private bool loading = true;

    private bool voting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rogatio = await ApiClient.GetRogatioByIdAsync(Id);

            if (rogatio == null)
            {
                Console.WriteLine($"Rogatio no encontrada para editar.");
                errorMessage = "Rogatio no encontrada para editar.";
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error de comunicación con la API: {ex.Message}");
            errorMessage = $"No se ha podido cargar el Rogatio: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }


    async Task Vote(SuffragiumValue votum)
    {
        if (voting)
        {
            return;
        }

        voting = true;

        try
        {
            var dto = new CreateSuffragiumDto
            {
                RogatioId = Id,
                Votum = votum
            };

            var result = await ApiClient.CreateSuffragiumAsync(Id, dto);
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"No se ha podido registrar el voto: {ex.Message}");
            errorMessage = $"No se ha podido registrar el voto: {ex.Message}";
        }
        finally
        {
            voting = false;
        }
    }


    async Task CambiarEstado(RogatioStatus nuevoEstado)
    {
        try
        {
            var dto = new WorkflowRogatioDto
            {
                Id = Id,
                Status = nuevoEstado
            };

            await ApiClient.ChangeRogatioStatusAsync(Id, dto);

            rogatio = await ApiClient.GetRogatioByIdAsync(Id);

            NavigationManager.NavigateTo($"/rogatio/{Id}");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al cambiar el estado: {ex.Message}");
            errorMessage = $"No se ha podido cambiar el estado: {ex.Message}";
        }
    }


}
