@page "/rogatio/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Shared.Dtos.Suffragium
@using CorpusLegis.Shared.Enums
@using CorpusLegis.Web.Components.Pages.Sententiae
@using CorpusLegis.Web.Components.Pages.Suffragium
@using Microsoft.AspNetCore.Authorization

@inject Clients.Rogatio.IRogatioClient RogatioApiClient
@inject Clients.Suffragium.ISuffragiumClient SuffragiumApiClient
@inject NavigationManager NavigationManager


<h3>Detalles del Rogatio [ID: xxx ]</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error: </strong>@errorMessage
    </div>
}

@if (loading)
{
    <p>Cargando</p>
}
else if (rogatio == null)
{
    <div class="alert alert-danger">Rogatio no encontrada.</div>
}
else
{
    <div class="row mt-4">
        <!-- Bloque principal: Título, Contenido y Votación -->
        <div class="col-12 col-md-8 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@rogatio.Title</h4>
                    <span class="badge bg-light text-dark">@rogatio.CivitasName</span>
                </div>

                <div class="card-body">
                    <p class="lead" style="white-space: pre-wrap;">@rogatio.Content</p>
                </div>

                <div class="card-footer bg-light p-4">
                    <h5 class="mb-3">Estado y Votaciones</h5>
                    @if (rogatio.Status == Shared.Enums.RogatioStatus.Inchoatus)
                    {
                        <div class="alert alert-secondary mb-0"><i>Aún no se puede votar (En borrador)</i></div>
                    }
                    else if (rogatio.Status == Shared.Enums.RogatioStatus.Proposita)
                    {
                        <div class="alert alert-info mb-0"><i>Abiertos los comentarios para el debate.</i></div>
                    }
                    else if (rogatio.Status == Shared.Enums.RogatioStatus.InSuffragium)
                    {
                        if (!rogatio.HasVoted)
                        {
                            <div class="mb-3 p-3 border rounded bg-white">
                                <p class="mb-2"><strong>Emite tu voto:</strong></p>
                                <button type="button" class="btn btn-outline-success me-2" @onclick="() => Vote(SuffragiumValue.Pro)" disabled="@voting">Pro</button>
                                <button type="button" class="btn btn-outline-danger me-2" @onclick="() => Vote(SuffragiumValue.Contra)" disabled="@voting">Contra</button>
                                <button type="button" class="btn btn-outline-warning" @onclick="() => Vote(SuffragiumValue.Abstentio)" disabled="@voting">Abstentio</button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mb-3">✓ Ya has emitido tu voto en esta Rogatio.</div>
                        }
                        <SuffragiumSummary ProVotes="@rogatio.ProVotes" ContraVotes="@rogatio.ContraVotes" AbstentioVotes="@rogatio.AbstentioVotes" />
                    }
                    else if (rogatio.Status == Shared.Enums.RogatioStatus.Approbata)
                    {
                        <div class="alert alert-success mb-3"><strong>Aprobada</strong></div>
                        <SuffragiumSummary ProVotes="@rogatio.ProVotes" ContraVotes="@rogatio.ContraVotes" AbstentioVotes="@rogatio.AbstentioVotes" />
                        <a class="btn btn-sm btn-outline-secondary mt-3" href="#">Clonar Rogatio (pendiente de crear)</a>
                    }
                    else if (rogatio.Status == Shared.Enums.RogatioStatus.Reprobata)
                    {
                        <div class="alert alert-danger mb-3"><strong>Rechazada</strong></div>
                        <SuffragiumSummary ProVotes="@rogatio.ProVotes" ContraVotes="@rogatio.ContraVotes" AbstentioVotes="@rogatio.AbstentioVotes" />
                        <a class="btn btn-sm btn-outline-secondary mt-3" href="#">Clonar Rogatio (pendiente de crear)</a>
                    }
                </div>
            </div>
        </div>

        <!-- Panel lateral: Información, Metadatos y Estructura -->
        <div class="col-12 col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Detalles de la Propuesta</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3 text-center">
                        <span class="badge bg-dark fs-6 w-100 py-2">Estado: @rogatio.Status</span>
                    </div>

                    <ul class="list-group list-group-flush mb-3 text-break">
                        <li class="list-group-item px-0">
                            <small class="text-muted d-block">Autor (Civis)</small>
                            <strong>@rogatio.CivisName</strong>
                            <div class="text-muted" style="font-size: 0.70rem;">ID: @rogatio.CivisId</div>
                        </li>
                        <li class="list-group-item px-0">
                            <small class="text-muted d-block">Comunidad (Civitas)</small>
                            <strong>@rogatio.CivitasName</strong>
                            <div class="text-muted" style="font-size: 0.70rem;">ID: @rogatio.CivitasId</div>
                        </li>
                        <li class="list-group-item px-0">
                            <div class="text-muted" style="font-size: 0.70rem;">Rogatio ID: @rogatio.Id</div>
                        </li>
                    </ul>

                    <h6 class="mt-4 border-bottom pb-2">Plazos</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <small class="text-muted d-block">Fecha de creación</small>
                            <span>@rogatio.CreatedAt.ToString("g")</span>
                        </li>
                        <li class="mb-2">
                            <small class="text-muted d-block text-primary fw-bold">Cierre (Tu hora local)</small>
                            <span class="fs-5">@rogatio.Deadline.ToLocalTime().ToString("g")</span>
                        </li>
                        <li>
                            <small class="text-muted d-block">Cierre (UTC)</small>
                            <span>@rogatio.Deadline.ToString("g")</span>
                        </li>
                    </ul>

                    <h6 class="mt-4 border-bottom pb-2">Requisitos de Aprobación</h6>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Quórum requerido:</span>
                        <strong>@((rogatio.RequiredQuorum * 100).ToString("0.##")) %</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Mayoría requerida:</span>
                        <strong>@((rogatio.RequiredMajority * 100).ToString("0.##")) %</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gestión de estados (Transiciones libres) -->
    <div class="card mb-4 border-info shadow-sm">
        <div class="card-body bg-light">
            <h6 class="card-title text-info mb-3">Acciones de Gestión (Transiciones)</h6>
            <div class="d-flex flex-wrap gap-2 align-items-center border-top pt-3">
                @* @if (rogatio.CivisId == CivisState.CurrentCivisId) { *@
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Inchoatus)">A borrador</button>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Proposita)">Presentar</button>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.InSuffragium)">A votar</button>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Approbata)">Aprobar</button>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Reprobata)">Rechazar</button>
                @* } *@
                <div class="ms-auto d-flex gap-2">
                    @if (rogatio.CanEdit)
                    {
                        <a class="btn btn-sm btn-secondary" href="rogatio/edit/@rogatio.Id">Editar</a>
                    }
                    @if (rogatio.CanDelete)
                    {
                        <a class="btn btn-sm btn-danger" href="rogatio/delete/@rogatio.Id">Eliminar</a>
                    }
                    <button type="button" class="btn btn-sm btn-warning" @onclick="() => EvaluarRogatio(RogatioStatus.InSuffragium)">Evaluar Reglas</button>
                </div>
            </div>
        </div>
    </div>


}

<div class="row mt-4">
    <a href="/rogatio" class="btn btn-lg btn-dark">Volver al listado de Rogationes</a>
</div>

<RogatioSententiae RogatioId="@Id" CanComment="@(rogatio != null && rogatio.Status == RogatioStatus.Proposita)" />


@code {
    [Parameter] public Guid Id { get; set; }

    private RogatioDetailsDto? rogatio;
    private string? errorMessage;
    private bool loading = true;

    private bool voting;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        loading = false;
    }


    async Task Vote(SuffragiumValue votum)
    {
        if (voting)
        {
            return;
        }

        voting = true;

        try
        {
            var dto = new CreateSuffragiumDto
            {
                RogatioId = Id,
                Votum = votum
            };

            var result = await SuffragiumApiClient.CreateSuffragiumAsync(Id, dto);

            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);

            StateHasChanged(); // se fuerza el renderizado.
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"No se ha podido registrar el voto: {ex.Message}");
            errorMessage = $"No se ha podido registrar el voto: {ex.Message}";
        }
        finally
        {
            voting = false;
        }

    }


    async Task CambiarEstado(RogatioStatus nuevoEstado)
    {
        try
        {
            var dto = new WorkflowRogatioDto
            {
                Id = Id,
                Status = nuevoEstado
            };

            await RogatioApiClient.ChangeRogatioStatusAsync(Id, dto);

            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);

            NavigationManager.NavigateTo($"/rogatio/{Id}");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al cambiar el estado: {ex.Message}");
            errorMessage = $"No se ha podido cambiar el estado: {ex.Message}";
        }
    }


    async Task EvaluarRogatio(RogatioStatus estadoActual)
    {
        try
        {
            var dto = new WorkflowRogatioDto
            {
                Id = Id,
                Status = estadoActual
            };
            await RogatioApiClient.EvaluateRogatioAsync(Id, dto);
            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);
            NavigationManager.NavigateTo($"/rogatio/{Id}");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al evaluar la Rogatio: {ex.Message}");
            errorMessage = $"No se ha podido evaluar la Rogatio: {ex.Message}";
        }
    }


    private async Task LoadDataAsync()
    {
        try
        {
            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);

            if (rogatio == null)
            {
                Console.WriteLine($"Rogatio no encontrada para mostrar detalles.");
                errorMessage = "Rogatio no encontrada para mostrar detalles.";
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error de comunicación con la API: {ex.Message}");
            errorMessage = $"No se ha podido cargar el Rogatio: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }


}
