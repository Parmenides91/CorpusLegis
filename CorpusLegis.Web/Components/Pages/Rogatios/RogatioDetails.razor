@page "/rogatio/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Shared.Dtos.Suffragium
@using CorpusLegis.Shared.Enums
@using CorpusLegis.Web.Components.Pages.Sententiae
@using CorpusLegis.Web.Components.Pages.Suffragium
@using Microsoft.AspNetCore.Authorization
@* @using CorpusLegis.Web.State *@

@* @implements IDisposable *@

@* @inject Clients.CorpusLegisApiClient ApiClient *@
@inject Clients.Rogatio.IRogatioClient RogatioApiClient
@inject Clients.Suffragium.ISuffragiumClient SuffragiumApiClient
@* @inject CorpusLegis.Web.State.CivisState CivisState *@
@inject NavigationManager NavigationManager


<h3>Detalles del Rogatio [ID: xxx ]</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error: </strong>@errorMessage
    </div>
}

@if (loading)
{
    <p>Cargando</p>
}
else if (rogatio == null)
{
    <div class="alert alert-danger">Rogatio no encontrada.</div>
}
else
{
    <div class="card mt-4">

        <div class="card-header bg-primary text-white">
            @* <h4 class="mb-0">@rogatio.Title</h4> *@
            <div class="row">
                <div class="col-sm-8">
                    <h4 class="mb-0">
                        @rogatio.Title
                        <span class="badge bg-secondary">@rogatio.CivitasName</span>
                    </h4>
                </div>
                <div class="col-sm-2">Civis: @rogatio.CivisName</div>
                <div class="col-sm-2">Civitas: @rogatio.CivitasName</div>
            </div>
        </div>

        <div class="card-body">
            <p class="lead">@rogatio.Content</p>
            <hr />
            <div class="row text-muted">
                <div class="col-sm-2"><strong>Estado: </strong> <span class="badge bg-secondary">@rogatio.Status</span></div>
                <div class="col-sm-2"><strong>ID: </strong> @rogatio.Id</div>
                <div class="col-sm-2"><strong>CivisId: </strong> @rogatio.CivisId</div>
                @* <div class="col-sm-2"><strong>CivisId: </strong> @rogatio.Civis</div> *@
                <div class="col-sm-2"><strong>CivitasId: </strong> @rogatio.CivitasId</div>
                @* <div class="col-sm-2"><strong>CivisId: </strong> @rogatio.Civitas</div> *@
                <div class="col-sm-2"><small><strong>Fecha de creación: </strong> @rogatio.CreatedAt.ToString("g")</small></div>
                <div class="col-sm-2"><small><strong>Quorum necesario para tomar decisión favorable sobre ella: </strong> @((rogatio.RequiredQuorum * 100).ToString("0.##")) %</small></div>
                <div class="col-sm-2"><small><strong>Mayoría necesaria para aprobar: </strong> @((rogatio.RequiredMajority * 100).ToString("0.##")) %</small></div>
            </div>
        </div>

        <div class="card-footer">
            @if (rogatio.Status == Shared.Enums.RogatioStatus.Inchoatus)
            {
                <i>Aún no se puede votar</i>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.Proposita)
            {
                <i>Abiertos los comentarios para el debate.</i>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.InSuffragium)
            {
                if (!rogatio.HasVoted)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => Vote(SuffragiumValue.Pro)" disabled="@voting">Pro</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Vote(SuffragiumValue.Contra)" disabled="@voting">Contra</button>
                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => Vote(SuffragiumValue.Abstentio)" disabled="@voting">Absentio</button>
                }
                else
                {
                    <div class="alert alert-info">Ya has emitido tu voto en esta Rogatio.</div>
                }
                @* <div class="d-flex justify-content-start gap-3 mt-3 mb-3">
                    <span class="badge bg-success">A favor: @rogatio.ProVotes</span>
                    <span class="badge bg-danger">En contra: @rogatio.ContraVotes</span>
                    <span class="badge bg-warning">Abstenciones: @rogatio.AbstentioVotes</span>
                </div> *@
                <SuffragiumSummary ProVotes="@rogatio.ProVotes" ContraVotes="@rogatio.ContraVotes" AbstentioVotes="@rogatio.AbstentioVotes" />
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.Approbata)
            {
                <p>Aprobada</p>
                <SuffragiumSummary ProVotes="@rogatio.ProVotes" ContraVotes="@rogatio.ContraVotes" AbstentioVotes="@rogatio.AbstentioVotes" />
                <a class="btn btn-sm btn-outline-secondary" href="#">Clonar Rogatio (pendiente de crear)</a>
            }
            else if (rogatio.Status == Shared.Enums.RogatioStatus.Reprobata)
            {
                <p>Rechazada</p>
                <SuffragiumSummary ProVotes="@rogatio.ProVotes" ContraVotes="@rogatio.ContraVotes" AbstentioVotes="@rogatio.AbstentioVotes" />
                <a class="btn btn-sm btn-outline-secondary" href="#">Clonar Rogatio (pendiente de crear)</a>
            }

        </div>

    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-start gap-3 mt-3 mb-3">
                <p>Transiciones disponibles:</p>
                @* @if (rogatio.CivisId == CivisState.CurrentCivisId)
                { *@
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Inchoatus)">A borrador</button>
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Proposita)">Presentar</button>
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.InSuffragium)">A votar</button>
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Approbata)">Aprobar</button>
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => CambiarEstado(RogatioStatus.Reprobata)">Rechazar</button>
                @* } *@
                <button type="button" class=" btn btn-sm btn-outline-warning" @onclick="() => EvaluarRogatio(RogatioStatus.InSuffragium)">Evaluar</button>
            </div>
        </div>
    </div>


}

<div class="row mt-4">
    <a href="/rogatio" class="btn btn-lg btn-dark">Volver al listado de Rogationes</a>
</div>

<RogatioSententiae RogatioId="@Id" CanComment="@(rogatio != null && rogatio.Status == RogatioStatus.Proposita)" />


@code {
    [Parameter] public Guid Id { get; set; }

    private RogatioDetailsDto? rogatio;
    private string? errorMessage;
    // private bool disposed;
    private bool loading = true;

    private bool voting;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        loading = false;
        // CivisState.OnChange += OnCivisChanged; // nos subscribimos a los cambios de la identidad.
    }


    async Task Vote(SuffragiumValue votum)
    {
        if (voting)
        {
            return;
        }

        voting = true;

        try
        {
            var dto = new CreateSuffragiumDto
            {
                RogatioId = Id,
                Votum = votum
            };

            var result = await SuffragiumApiClient.CreateSuffragiumAsync(Id, dto);

            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);

            StateHasChanged(); // se fuerza el renderizado.
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"No se ha podido registrar el voto: {ex.Message}");
            errorMessage = $"No se ha podido registrar el voto: {ex.Message}";
        }
        finally
        {
            voting = false;
        }

    }


    async Task CambiarEstado(RogatioStatus nuevoEstado)
    {
        try
        {
            var dto = new WorkflowRogatioDto
            {
                Id = Id,
                Status = nuevoEstado
            };

            await RogatioApiClient.ChangeRogatioStatusAsync(Id, dto);

            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);

            NavigationManager.NavigateTo($"/rogatio/{Id}");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al cambiar el estado: {ex.Message}");
            errorMessage = $"No se ha podido cambiar el estado: {ex.Message}";
        }
    }


    async Task EvaluarRogatio(RogatioStatus estadoActual)
    {
        try
        {
            var dto = new WorkflowRogatioDto
            {
                Id = Id,
                Status = estadoActual
            };
            await RogatioApiClient.EvaluateRogatioAsync(Id, dto);
            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);
            NavigationManager.NavigateTo($"/rogatio/{Id}");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al evaluar la Rogatio: {ex.Message}");
            errorMessage = $"No se ha podido evaluar la Rogatio: {ex.Message}";
        }
    }


    private async Task LoadDataAsync()
    {
        try
        {
            rogatio = await RogatioApiClient.GetRogatioByIdAsync(Id);

            if (rogatio == null)
            {
                Console.WriteLine($"Rogatio no encontrada para mostrar detalles.");
                errorMessage = "Rogatio no encontrada para mostrar detalles.";
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error de comunicación con la API: {ex.Message}");
            errorMessage = $"No se ha podido cargar el Rogatio: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }


