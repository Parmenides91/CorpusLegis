@page "/rogatio"
@rendermode InteractiveServer
@attribute [Authorize]

@using CorpusLegis.Shared.Dtos
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@* @inject Clients.CorpusLegisApiClient ApiClient *@
@inject Clients.Rogatio.IRogatioClient ApiClient
@inject NavigationManager NavigationManager


<h3>Rogationes actuales (todas? usuario?)</h3>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}


@if (rogationes == null)
{
    <p><em>Cargando del Senado...</em></p>
}
else if (!rogationes.Any())
{
    <p>No hay Rogationes registradas en el Codex actualmente.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Estado</th>
                <th>Fecha de creación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rogatio in rogationes)
            {
                <tr>
                    <td>
                        @rogatio.Title
                        <span class="badge bg-secondary">@rogatio.CivitasName</span>
                    </td>
                    <td>@rogatio.Status</td>
                    <td>@rogatio.CreatedAt</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary ms-2" href="rogatio/@rogatio.Id">Ver detalles</a>
                        @if (rogatio.CanEdit)
                        {
                            <a class="btn btn-sm btn-outline-secondary ms-2" href="rogatio/edit/@rogatio.Id">Editar</a>
                        }
                        @if (rogatio.CanDelete)
                        {
                            <a class="btn btn-sm btn-outline-warning ms-2" href="rogatio/delete/@rogatio.Id">¿Eliminar?</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RogatioSummaryDto>? rogationes;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

    }

    private async Task LoadDataAsync()
    {
        try
        {
            errorMessage = null; // Limpiar cualquier mensaje de error previo

            rogationes = await ApiClient.GetRogationesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Console.WriteLine($"Error de autorización: {ex.Message}");
            errorMessage = "Tu sesión ha expirado o necesitas iniciar sesión para ver esta información.";
            //NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al cargar los Rogationes: {ex.Message}");
            errorMessage = $"Error al cargar los Rogationes: {ex.Message}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inesperado: {ex.Message}");
            errorMessage = "Ha ocurrido un error inesperado al intentar cargar los datos.";
        }
    }
}
