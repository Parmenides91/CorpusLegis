@page "/rogatio"
@rendermode InteractiveServer

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Web.State
@* @using Microsoft.AspNetCore.Components.Authorization *@

@implements IDisposable

@inject Clients.CorpusLegisApiClient ApiClient
@inject CorpusLegis.Web.State.CivisState CivisState



<h3>Rogationes actuales (todas? usuario?)</h3>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}


@if (rogationes == null)
{
    <p><em>Cargando del Senado...</em></p>
}
else if (!rogationes.Any())
{
    <p>No hay Rogationes registradas en el Codex actualmente.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Estado</th>
                <th>Fecha de creación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rogatio in rogationes)
            {
                <tr>
                    <td>
                        @rogatio.Title
                        <span class="badge bg-secondary">@rogatio.CivitasName</span>
                    </td>
                    <td>@rogatio.Status</td>
                    <td>@rogatio.CreatedAt</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="rogatio/@rogatio.Id">Ver detalles</a>
                        @if (rogatio.Status == Shared.Enums.RogatioStatus.Inchoatus && rogatio.CivisId == CivisState.CurrentCivisId)
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="rogatio/edit/@rogatio.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-warning" href="rogatio/delete/@rogatio.Id">¿Eliminar?</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RogatioSummaryDto>? rogationes;
    private string? errorMessage;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        CivisState.OnChange += OnCivisChanged;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            errorMessage = null; // Limpiar cualquier mensaje de error previo

            rogationes = await ApiClient.GetRogationesAsync();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error al cargar los Rogationes: {ex.Message}");
            errorMessage = $"Error al cargar los Rogationes: {ex.Message}";
        }
    }

    private async void OnCivisChanged()
    {
        if (disposed)
        {
            return;
        }

        // await LoadDataAsync(); // si cambia el usuario, se vuelven a pedir los datos a la API.

        // await InvokeAsync(StateHasChanged); // forzar el repintado.

        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        }
        );
    }

    public void Dispose()
    {
        disposed = true;

        CivisState.OnChange -= OnCivisChanged;
    }
}
