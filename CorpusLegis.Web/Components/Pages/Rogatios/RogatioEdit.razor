@page "/rogatio/edit/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Web.Clients.Base
@using Microsoft.AspNetCore.Authorization

@implements IDisposable

@inject Clients.Rogatio.IRogatioClient RogatioApiClient
@inject NavigationManager NavigationManager
@inject ILogger<RogatioEdit> Logger


<h3>Edición del Rogatio [ID: xxx ]</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error: </strong>@errorMessage
    </div>
}

@if (loading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">. . . Cargando . . .</span>
    </div>
}
else if (_editContext is not null && editModel is not null)
{
    <EditForm EditContext="@_editContext" OnValidSubmit="HandleSubmit">
        <ValidationSummary/>

        <div class="mb-3">
            <label for="title" class="form-label">Título</label>
            <InputText id="title" class="form-control" @bind-Value="editModel.Title" />
            <ValidationMessage For="@(() => editModel.Title)" />
        </div>

        <div class="row d-flex align-items-stretch">
            <div class="col-12 col-md-8 d-flex flex-column">

                <div class="mb-3">
                    <label for="content" class="form-label">Contenido</label>
                    <InputTextArea id="content" class="form-control" @bind-Value="editModel.Content" />
                    <ValidationMessage For="@(() => editModel.Content)" />
                </div>

            </div>

            <div class="col-12 col-md-4 d-flex flex-column">

                <div class="card mb-3 h-100">
                    <div class="card-body">
                        <h6 class="card-title">Opciones</h6>

                        <div class="mb-3">
                            <label for="deadline" class="form-label">Fecha límite</label>
                            <InputDate id="deadline" class="form-control" @bind-Value="editModel.Deadline" />
                            <ValidationMessage For="@(() => editModel.Deadline)" />
                        </div>

                        <div class="mb-3">
                            <label for="requiredQuota" class="form-label">Quorum necesario para aprobación</label>
                            <div class="input-group">
                                <InputNumber id="requiredQuota" class="form-control" @bind-Value="editModel.RequiredQuorum" step="0.01" min="0.01" max="1.00" />
                                <span class="input-group-text">@FormatAsPercent(editModel.RequiredQuorum)</span>
                            </div>
                            <ValidationMessage For="@(() => editModel.RequiredQuorum)" />
                        </div>

                        <div class="mb-3">
                            <label for="requiredMajority" class="form-label">Mayoría necesaria para aprobación</label>
                            <div class="input-group">
                                <InputNumber id="requiredMajority" class="form-control" @bind-Value="editModel.RequiredMajority" step="0.01" min="0.01" max="1.00" />
                                <span class="input-group-text">@FormatAsPercent(editModel.RequiredMajority)</span>
                            </div>
                            <ValidationMessage For="@(() => editModel.RequiredMajority)" />
                        </div>

                    </div>
                </div>

                <div class="d-grid">
                    <button class="btn btn-primary mt-2" type="submit" disabled="@saving">
                        @(saving ? "Guardando..." : "Guardar")
                    </button>
                    <button class="btn btn-secondary mt-2" type="button" @onclick="CancelEdit">Cancelar</button>
                </div>

            </div>

        </div>

    </EditForm>
}
else
{
    <div class="alert alert-warning">No se ha podido cargar el formulario de edición de la Rogatio.</div>
}


@code {
    [Parameter] public Guid Id { get; set; }

    private UpdateRogatioDto? editModel;
    private bool loading = true;
    private bool saving = false;

    private EditContext? _editContext;
    private ValidationMessageStore? _validationMessageStore;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dto = await RogatioApiClient.GetRogatioByIdAsync(Id);

            if (dto != null)
            {
                editModel = new UpdateRogatioDto
                    {
                        Title = dto.Title,
                        Content = dto.Content,
                        Status = dto.Status,
                        Deadline = dto.Deadline,
                        RequiredQuorum = dto.RequiredQuorum,
                        RequiredMajority = dto.RequiredMajority
                    };
                _editContext = new EditContext(editModel);
                // _validationMessageStore = new ValidationMessageStore(_editContext);
                _validation_message_store_init();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando Rogatio para edición.");
            errorMessage = "No se pudo cargar el Rogatio para editar.";
        }
        finally
        {
            loading = false;
        }

    }


    private void _validation_message_store_init()
    {
        if (_editContext == null)
        {
            return;
        }

        _validationMessageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += EditContext_OnFieldChanged;
    }


    private void EditContext_OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (_validationMessageStore == null)
        {
            return;
        }

        _validationMessageStore.Clear(e.FieldIdentifier);
        _editContext?.NotifyValidationStateChanged();
    }


    private async Task HandleSubmit()
    {
        if (editModel == null || _editContext == null || _validationMessageStore == null)
        {
            Logger.LogError("Intento de guardar sin un modelo de edición válido o sin EditContext/ValidationMessageStore.");
            Console.WriteLine($"No se ha podido cargar el Rogatio para editar.");
            errorMessage = "No se ha podido cargar el Rogatio para editar.";
            return;
        }

        saving = true;
        errorMessage = null;
        _validationMessageStore?.Clear();
        _editContext?.NotifyValidationStateChanged();

        try
        {
            await RogatioApiClient.UpdateRogatioAsync(Id, editModel);
            NavigationManager.NavigateTo($"/rogatio/{Id}");
        }
        catch (ApiValidationException vex)
        {
            _validationMessageStore?.Clear();

            foreach (var kv in vex.Errors)
            {
                var key = kv.Key;
                string propertyName = key switch
                {
                    var s when s.EndsWith("Title", StringComparison.OrdinalIgnoreCase) => nameof(UpdateRogatioDto.Title),
                    var s when s.EndsWith("Content", StringComparison.OrdinalIgnoreCase) => nameof(UpdateRogatioDto.Content),
                    var s when s.EndsWith("Deadline", StringComparison.OrdinalIgnoreCase) => nameof(UpdateRogatioDto.Deadline),
                    var s when s.EndsWith("RequiredQuorum", StringComparison.OrdinalIgnoreCase) => nameof(UpdateRogatioDto.RequiredQuorum),
                    var s when s.EndsWith("RequiredMajority", StringComparison.OrdinalIgnoreCase) => nameof(UpdateRogatioDto.RequiredMajority),
                    _ => key
                };

                var field = new FieldIdentifier(editModel, propertyName);
                _validationMessageStore?.Add(field, kv.Value);
            }

            _editContext?.NotifyValidationStateChanged();
            errorMessage = "Por favor, corrige los errores en el formulario.";
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = httpEx.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error inesperado al guardar la Rogatio.");
            errorMessage = "Se ha producido un error inesperado. Intenta recargar la página.";
        }
        finally
        {
            saving = false;
        }

    }


    private static string FormatAsPercent(decimal value)
    {
        //Multiplica por 100 y muestra con 0 o 1 decimales según prefieras
        return $"{Math.Round(value * 100, 2):0.##}%";
    }


    private void CancelEdit()
    {
        NavigationManager.NavigateTo($"/rogatio");
    }


    public void Dispose()
    {
        if (_editContext != null)
        {
            _editContext.OnFieldChanged -= EditContext_OnFieldChanged;
        }
    }

}
