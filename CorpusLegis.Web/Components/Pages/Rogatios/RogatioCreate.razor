@page "/rogatio/nueva"
@rendermode InteractiveServer
@attribute [Authorize]

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Shared.Dtos.Civitas
@using CorpusLegis.Web.Clients.Base
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@implements IDisposable

@inject Clients.Rogatio.IRogatioClient RogatioApiClient
@inject Clients.Civitas.ICivitasClient CivitasApiClient
@inject NavigationManager NavigationManager
@inject ILogger<RogatioCreate> Logger


<h3>Redacción de un nuevo Rogatio</h3>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error: </strong>@errorMessage
    </div>
}


<EditForm EditContext="@_editContext" FormName="createRogatioForm" OnValidSubmit="HandleSubmit">
    <ValidationSummary />

    <div class="mb-3">
        <label for="title" class="form-label">Título</label>
        <InputText id="title" class="form-control" @bind-Value="newRogatio.Title" />
        <ValidationMessage For="@(() => newRogatio.Title)" />
    </div>

    <div class="row">
        <div class="col-12 col-md-8">

            <div class="mb-3">
                <label for="content" class="form-label">Contenido</label>
                <InputTextArea id="content" class="form-control" @bind-Value="newRogatio.Content" style="min-height:420px; resize:vertical;" />
                <ValidationMessage For="@(() => newRogatio.Content)" />
            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="mb-3">
                <label for="civitas" class="form-label">Civitas</label>
                <InputSelect id="civitas" class="form-select" @bind-Value="newRogatio.CivitasId">
                    <option value="">Seleccione una Civitas</option>
                    @foreach (var civitasItem in civitas)
                    {
                        <option value="@civitasItem.Id">@civitasItem.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => newRogatio.CivitasId)" />
            </div>

            <div class="mb-3">
                <label for="deadline" class="form-label">Fecha límite</label>
                <div class="input-group">
                    <InputDate id="deadline" class="form-control" @bind-Value="DeadlineLocal" Type="InputDateType.DateTimeLocal" />
                    <span class="input-group-text" title="Valor que se almacenará en el servidor">UTC: @DeadlineLocal.ToUniversalTime().ToString("g")</span>
                </div>
                <div class="form-text">Introduce fecha y hora local. Se traducirá y almacenará en UTC.</div>
                <ValidationMessage For="@(() => newRogatio.Deadline)" />
            </div>

            <div class="mb-3">
                <label for="requiredQuorum" class="form-label">
                    Quórum necesario
                </label>
                <div class="input-group">
                    <InputNumber id="requiredQuorum" class="form-control" @bind-Value="newRogatio.RequiredQuorum" step="0.01" min="0.01" max="1.00"/>
                    <span class="input-group-text">@FormatAsPercent(newRogatio.RequiredQuorum)</span>
                </div>
                <div class="form-text">Ingrese un valor entre 0.01 y 1.00 (ej. 0.51 = 51%)</div>
                <ValidationMessage For="@(() => newRogatio.RequiredQuorum)" />
            </div>

            <div class="mb-3" >
                <label for="requiredMajority" class="form-label">
                    Mayoría necesaria
                </label>
                <div class="input-group">
                    <InputNumber id="requiredMajority" class="form-control" @bind-Value="newRogatio.RequiredMajority" step="0.01" min="0.01" max="1.00"/>
                    <span class="input-group-text">@FormatAsPercent(newRogatio.RequiredMajority)</span>
                </div>
                <div class="form-text">Ingrese un valor entre 0.00 y 1.00 (ej. 0.51 = 51%)</div>
                <ValidationMessage For="@(() => newRogatio.RequiredMajority)" />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary" disabled="@isProcessing">Crear Rogatio</button>
            </div>

        </div>
    </div>

</EditForm>


@code {

    private CreateRogatioDto newRogatio = new();
    private List<CivitasSummaryDto> civitas = new();
    private bool isProcessing = false;

    private EditContext? _editContext;
    private ValidationMessageStore? _validationMessageStore;
    private string? errorMessage;

    private DateTime _deadlineLocal;
    private DateTime DeadlineLocal
    {
        get => _deadlineLocal;
        set
        {
            if (_deadlineLocal != value)
            {
                _deadlineLocal = value;
                if (_validationMessageStore != null && _editContext != null)
                {
                    _validationMessageStore.Clear(new FieldIdentifier(newRogatio, nameof(CreateRogatioDto.Deadline)));
                    _editContext.NotifyValidationStateChanged();
                }
                errorMessage = null;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(newRogatio);
        _validationMessageStore = new ValidationMessageStore(_editContext);

        _editContext.OnFieldChanged += EditContext_OnFieldChanged;

        DeadlineLocal = newRogatio.Deadline.ToLocalTime();

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            civitas = await CivitasApiClient.GetUserCivitatesAsync();
        }
        catch (ApplicationException ex)
        {
            Logger.LogWarning(ex, "Error al cargar datos para el formulario de creación de Rogationes.");
            errorMessage = $"Error al cargar datos: {ex.Message}";
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Acceso denegado al cargar Civitates.");
            errorMessage = "Tu sesión ha expirado o necesitas iniciar sesión para ver esta información.";
            //NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Error al cargar el formulario de creación de Rogationes.");
            errorMessage = $"Error al cargar el formulario de creación de Rogationes: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error crítico al cargar los datos del formulario.");
            errorMessage = $"Ha ocurrido un error inesperado al intentar cargar el formulario de creación de Rogationes: {ex.Message}";
        }

    }


    private void EditContext_OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (_validationMessageStore == null || _editContext == null)
        {
            return;
        }

        _validationMessageStore?.Clear(e.FieldIdentifier);
        _editContext?.NotifyValidationStateChanged();
        errorMessage = null;
    }


    private async Task HandleSubmit()
    {
        if (isProcessing)
        {
            return;
        }

        isProcessing = true;
        errorMessage = null;
        _validationMessageStore?.Clear();
        _editContext?.NotifyValidationStateChanged();

        try
        {
            SyncDeadlineFromLocal();
            var createdRogatio = await RogatioApiClient.CreateRogatioAsync(newRogatio);
            NavigationManager.NavigateTo("/rogatio");
        }
        catch (ApiValidationException vex)
        {
            _validationMessageStore?.Clear();

            foreach (var kv in vex.Errors)
            {
                var key = kv.Key;
                string propertyName = key switch
                {
                    var s when s.EndsWith("Title", StringComparison.OrdinalIgnoreCase) => nameof(CreateRogatioDto.Title),
                    var s when s.EndsWith("Content", StringComparison.OrdinalIgnoreCase) => nameof(CreateRogatioDto.Content),
                    var s when s.EndsWith("CivitasId", StringComparison.OrdinalIgnoreCase) => nameof(CreateRogatioDto.CivitasId),
                    var s when s.EndsWith("Deadline", StringComparison.OrdinalIgnoreCase) => nameof(CreateRogatioDto.Deadline),
                    var s when s.EndsWith("RequiredQuorum", StringComparison.OrdinalIgnoreCase) => nameof(CreateRogatioDto.RequiredQuorum),
                    var s when s.EndsWith("RequiredMajority", StringComparison.OrdinalIgnoreCase) => nameof(CreateRogatioDto.RequiredMajority),
                    _ => key
                };

                var field = new FieldIdentifier(newRogatio, propertyName);
                _validationMessageStore?.Add(field, kv.Value);
            }

            _editContext?.NotifyValidationStateChanged();
            errorMessage = "Por favor, corrige los errores en el formulario.";
        }
        catch (ApplicationException ex)
        {
            Logger.LogWarning(ex, "Error al crear el Rogatio.");
            errorMessage = $"Error de comunicación con la API: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error crítico al crear el Rogatio.");
            errorMessage = $"Ha ocurrido un error inesperado: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }


    private static string FormatAsPercent(decimal value)
    {
        //Multiplica por 100 y muestra con 0 o 1 decimales según prefieras
        return $"{Math.Round(value * 100, 2):0.##}%";
    }

    private void SyncDeadlineFromLocal()
    {
        var local = DateTime.SpecifyKind(DeadlineLocal, DateTimeKind.Local);
        newRogatio.Deadline = local.ToUniversalTime();
    }

    public void Dispose()
    {
        if (_editContext != null)
        {
            _editContext.OnFieldChanged -= EditContext_OnFieldChanged;
        }
    }


}
