@page "/rogatio/nueva"
@rendermode InteractiveServer

@using CorpusLegis.Shared.Dtos
@using CorpusLegis.Shared.Dtos.Civitas

@* @implements IDisposable *@

@inject Clients.CorpusLegisApiClient ApiClient
@* @inject CorpusLegis.Web.State.CivisState CivisState *@
@inject NavigationManager NavigationManager


<h3>Redacción de un nuevo Rogatio</h3>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error: </strong>@errorMessage
    </div>
}


<EditForm Model="@newRogatio" FormName="createRogatioForm" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="title" class="form-label">Título</label>

        <InputText id="title" class="form-control" @bind-Value="newRogatio.Title" />

        <ValidationMessage For="@(() => newRogatio.Title)" />
    </div>

    <div class="mb-3">
        <label for="content" class="form-label">Contenido</label>

        <InputTextArea id="content" class="form-control" @bind-Value="newRogatio.Content" />

        <ValidationMessage For="@(() => newRogatio.Content)" />
    </div>

    <div class="mb-3">
        <label for="civitas" class="form-label>">Civitas</label>
        <InputSelect id="civitas" class="form-select" @bind-Value="newRogatio.CivitasId">
            <option value="">Seleccione una Civitas</option>
            @foreach (var civitasItem in civitas)
            {
                <option value="@civitasItem.Id">@civitasItem.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => newRogatio.CivitasId)" />
    </div>

    <button type="submit" class="btn btn-primary">Crear Rogatio</button>

</EditForm>


@code {

    private CreateRogatioDto newRogatio = new();
    private List<CivitasSummaryDto> civitas = new();
    private string? errorMessage;
    // private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        // CivisState.OnChange += OnCivisChanged;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            civitas = await ApiClient.GetUserCivitatesAsync();
        }
        catch (ApplicationException ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
            errorMessage = $"Error al cargar datos: {ex.Message}";
        }
        
    }

    private async Task HandleSubmit()
    {
        try
        {
            errorMessage = null; // Limpiar cualquier mensaje de error previo

            var createdRogatio = await ApiClient.CreateRogatioAsync(newRogatio); // Llamar al API para crear el nuevo Rogatio

            NavigationManager.NavigateTo("/rogatio"); // Redireccionar al listado de Rogatio después de crear uno nuevo
        }
        //catch (HttpRequestException ex)
        catch (ApplicationException ex)
        {
            Console.WriteLine($"Error de comunicación con la API: {ex.Message}");
            errorMessage = $"Error de comunicación con la API: {ex.Message}";
        }
        // catch (Exception ex)
        // {
        //     Console.WriteLine($"Error al crear el Rogatio: {ex.Message}");
        //     errorMessage = $"Ha ocurrido un error inesperado: {ex.Message}";
        // }
    }


