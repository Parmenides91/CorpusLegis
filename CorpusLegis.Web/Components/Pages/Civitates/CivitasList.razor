@page "/civitas"
@rendermode InteractiveServer

@using CorpusLegis.Shared.Dtos.Civitas
@using CorpusLegis.Web.State

@inject Clients.CorpusLegisApiClient ApiClient
@inject CorpusLegis.Web.State.CivisState CivisState


<h3>Listado de Civitas</h3>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (civitates == null)
{
    <p><em>Cargando las murallas...</em></p>
}
else if (!civitates.Any())
{
    <p>No hay Civitates dadas de alta.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Fecha de fundación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var civitas in civitates)
            {
                <tr>
                    <td>@civitas.Name</td>
                    <td>@civitas.FoundedAt</td>
                    <td>
                        @* ¿Todo el mundo puede ver todas las Civitas que hay? *@
                        <a class="btn btn-sm btn-outline-primary" href="civitas/@civitas.Id">Ver detalles</a>
                        @if (civitas.isMember)
                        {
                            <span class="badge bg-success ms-2">Miembro</span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => JoinCivitas(civitas.Id)" disabled="@joining">Solicitar unirse</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private List<CivitasSummaryDto>? civitates;
    private string? errorMessage;
    private bool joining;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        CivisState.OnChange += OnCivisChanged;
    }

    private async Task LoadDataAsync()
    {
        errorMessage = null;

        try
        {
            civitates = await ApiClient.GetCivitatesAsync();
        }
        catch (ApplicationException ex)
        {
            Console.WriteLine($"Error al cargar las Civitates: {ex.Message}.");
            errorMessage = $"Error al cargar las Civitates: {ex.Message}.";
        }
    }

    async Task JoinCivitas(Guid id)
    {
        if (joining)
        {
            return;
        }

        joining = true;

        try
        {
            await ApiClient.JoinCurrentCivisToCivitasAsync(id);

            civitates = await ApiClient.GetCivitatesAsync(); // recargamos las civitas para actualizar el estado de "isMember".

            joining = false;

            StateHasChanged();
        }
        catch (ApplicationException ex)
        {
            Console.WriteLine($"Error al agregar el Civis a la Civitas: {ex.Message}.");
            errorMessage = $"Error al agregar el Civis a la Civitas: {ex.Message}.";
        }
        
    }

    private async void OnCivisChanged()
    {
        await LoadDataAsync(); // si cambia el usuario, se vuelven a pedir los datos a la API.

        await InvokeAsync(StateHasChanged); // forzar el repintado.
    }

    public void Dispose()
    {
        CivisState.OnChange -= OnCivisChanged;
    }

}
