@page "/perfil"

@using CorpusLegis.Shared.Dtos.Reputatio
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Clients.Civis.ICivisClient CivisApiClient
@inject ILogger<Profile> Logger


<PageTitle>Perfil del Civis</PageTitle>

<h3>Perfil Civis</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error: </strong>@errorMessage
    </div>
}

@if (_isLoading)
{
    <p>Cargando información del Civis.</p>
}
else if (_reputatio is not null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Reputación pública</h5>
            <p class="card-text">Puntuación total: <strong>@_reputatio.TotalScore</strong></p>
            <p class="text-muted">Última actualización: @_reputatio.LastUpdated</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning mt-3">
        No se ha podido recuperar la información de Reputatio o el Civis no tiene actividad registrada.
    </div>
}

@if (_claimsList is not null)
{
    <ul class="list-group">
        @foreach (var c in _claimsList)
        {
            <li class="list-group-item"><strong>@c.Type</strong>: @c.Value</li>
        }
    </ul>
}


@code {
    private ReputatioDto? _reputatio;
    private bool _isLoading = true;

    private string? errorMessage;

    private List<(string Type, string Value)>? _claimsList;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            _claimsList = user.Claims.Select(c => (c.Type, c.Value)).ToList();

            var civisIdString = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(civisIdString, out var civisId))
            {
                try
                {
                    _reputatio = await CivisApiClient.GetReputatioAsync(civisId);
                }
                catch (HttpRequestException httpEx)
                {
                    Logger.LogWarning(httpEx, "Error HTTP al obtener Reputatio para Civis {CivisId}", civisId);
                    _reputatio = null;
                }
                catch (UnauthorizedAccessException uaEx)
                {
                    Logger.LogWarning(uaEx, "No autorizado al solicitar Reputatio.");
                    _reputatio = null;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error inesperado al obtener Reputatio para Civis {CivisId}", civisId);
                    errorMessage = "Error inesperado";
                    _reputatio = null;
                }
            }
            else
            {
                Logger.LogWarning("Claim NameIdentifier no contiene GUID válido: {Claim}", civisIdString);
            }
        }

        _isLoading = false;
    }


}
