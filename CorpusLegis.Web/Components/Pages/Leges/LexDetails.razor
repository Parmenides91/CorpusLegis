@page "/lex/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using CorpusLegis.Shared.Dtos.Lex
@using Microsoft.AspNetCore.Authorization

@* @inject Clients.CorpusLegisApiClient ApiClient *@
@inject Clients.Lex.ILexClient ApiClient



<h3>Detalles de la Lex [ID: LLL]</h3>


@if (lex != null)
{
    <div class="card mt-4">

        <div class="card-header bg-primary text-white">
            <div class="row">
                <div class="col-sm-8">
                    <h4 class="mb-0">@lex.Title</h4>
                </div>
                <div class="col-sm-2">Civis: @* @lex.CivisName *@</div>
                <div class="col-sm-2">Civitas: @* @lex.CivitasName *@</div>
            </div>
        </div>

        <div class="card-body">
            <p class="lead">@lex.Content</p>
            <hr />
            <div class="row text-muted">
                <div class="col-sm-2"><strong>ID: </strong> @lex.Id</div>
                <div class="col-sm-2"><strong>CivisId: </strong> @* @lex.CivisId *@</div>
                <div class="col-sm-2"><strong>CivitasId: </strong> @lex.CivitasId</div>
                <div class="col-sm-2"><small><strong>Fecha de creación: </strong> @lex.PromulgatedA.ToString("g")</small></div>
            </div>
        </div>

        <div class="card-footer">
            <a class="btn btn-sm btn-outline-secondary" href="rogatio/@lex.OriginRogatioId">Detalles de la Rogatio original</a>
        </div>

    </div>

}

<div class="row mt-4">
    <a href="/lex" class="btn btn-lg btn-dark">Volver al listado de Leges</a>
</div>


@code {
    [Parameter] public Guid Id { get; set; }

    private LexDetailsDto? lex;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            lex = await ApiClient.GetLexByIdAsync(Id);

            if (lex == null)
            {
                Console.WriteLine($"No se ha encontrado la Lex de la que mostrar detalles.");
                errorMessage = "No se ha encontrado la Lex de la que mostrar detalles.";
            }
        }
        catch (ApplicationException ex)
        {
            Console.WriteLine($"Error de comunicación con la API: {ex.Message}.");
            errorMessage = $"Error de comunicación con la API: {ex.Message}.";
        }

    }

}
