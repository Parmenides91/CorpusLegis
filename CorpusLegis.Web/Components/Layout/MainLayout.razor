@inherits LayoutComponentBase

@inject CorpusLegis.Web.State.CivisState CivisState


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="d-flex align-items-center">
                <span class="me-2 fw-bold text-muted">Actuando como: </span>

                @* <select class="form-select form-select-sm" @onchange="OnCivisChanged">
                    <option value="0f8fad5b-d9cb-469f-a165-70867728950e" selected>Sempronio</option>
                    <option value="11111111-1111-1111-1111-111111111111">Tulio</option>
                </select> *@

                <select class="form-select form-select-sm" @bind="CurrentCivisId">
                    <option value="0f8fad5b-d9cb-469f-a165-70867728950e" selected>Sempronio</option>
                    <option value="11111111-1111-1111-1111-111111111111">Tulio</option>
                </select>

            </div>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



@code {
    // private void OnCivisChanged(ChangeEventArgs e)
    // {
    //     if (Guid.TryParse(e.Value?.ToString(), out var newCivisId))
    //     {
    //         CivisState.SetCivis(newCivisId);
    //     }
    // }

    // Propiedad intermedia que enlaza la UI con mi State.
    private Guid CurrentCivisId
    {
        get => CivisState.CurrentCivisId;
        set => CivisState.SetCivis(value);
    }

    protected override void OnInitialized()
    {
        // Nos suscribimos a los cambios de estado para repintar la UI si hace falta
        CivisState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CivisState.OnChange -= StateHasChanged;
    }

}