@implements IDisposable

@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Authorization

@inject CorpusLegis.Web.State.TokenProvider TokenProvider
@inject PersistentComponentState ApplicationState


@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration



<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
@*         <div class="top-row px-4">
            <div class="d-flex align-items-center"> *@

                @* Añadimos los enlaces para Login y Logout *@
        @*<a href="/login" class="ms-3">Login</a>
                <a href="/logout" class="ms-3">Logout</a>*@
                @* Logged in as @context.User.Claims.Aggregate("", (s, claim) => s += ";\n" + claim ) *@
        @*</div>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
</div> *@
        <div class="top-row px-4">
            <div class="d-flex align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <span class="ms-3 me-3">Salve, @context.User.Identity?.Name</span>
                        <a href="@($"{Configuration["Keycloak:Authority"]}/account/")" target="_blank" class="btn btn-link text-decoration-none">Mi Perfil (Keycloak)</a>
                        <a href="/perfil" class="ms-3">Perfil Civis</a>
                        <form action="/logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-link text-decoration-none">Logout</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="ms-3">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @if (_isStateLoaded)
            {
                @Body
            }
            else
            {
                <p>Inicializando sesión y estado de la aplicación...</p>
            }
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
    private PersistingComponentStateSubscription _subscription;
    private bool _isStateLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("TokenProvider length: " + (TokenProvider.AccessToken?.Length ?? 0)); // TODO: eliminar este debug.

        // se registra el evento de persistencia para el paso de SSR a SignalR.
        _subscription = ApplicationState.RegisterOnPersisting(PersistToken);

        // se trata de recuperar el token si estamos en la fase de SignalR.
        if (!ApplicationState.TryTakeFromJson<string>("AccessToken", out var restoredToken))
        {
            // fase SSR: se extrae el HttpContext
            if (HttpContext is not null)
            {
                var token = await HttpContext.GetTokenAsync("access_token");
                if (!string.IsNullOrEmpty(token))
                {
                    TokenProvider.AccessToken = token;
                }
            }
        }
        else
        {
            // fase SignalR: se restaura el token.
            TokenProvider.AccessToken = restoredToken;
        }

        _isStateLoaded = true;
    }

    private Task PersistToken()
    {
        ApplicationState.PersistAsJson("AccessToken", TokenProvider.AccessToken);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }


}
